# Copy to terraform.tfvars and adjust.

cluster_name      = "my-cluster"
region            = "eu-central-1"
name_prefix       = "kube-handrail"
sandbox_namespace = "kube-handrail-sandbox"

min_replicas     = 0
max_replicas     = 5
plan_ttl_seconds = 300

# Oscillation breaker (mcp/CONTRACT.md, History checks).
flap_window_seconds        = 600
object_hourly_apply_budget = 6
plan_rate_limit            = 20
plan_rate_window_seconds   = 600
apply_cooldown_seconds     = 60
global_hourly_apply_budget = 30

# Blast-radius budget (mcp/CONTRACT.md, Guard checks): the largest change in
# replicas per plan, as a percentage of the current count, rounded up, at least 1.
max_replica_step_percent = 100

# The kill switch parameter is created with the value "true" and Terraform
# ignores later changes to it, so it can be flipped without being reset:
#   aws ssm put-parameter --overwrite --name <kill_switch_parameter> --value false

# Drift sentinel (mcp/CONTRACT.md, Drift sentinel). Set the DevOps Agent IDs only
# after enable-write; empty IDs limit the sentinel to the gateway check.
sentinel_enabled            = true
sentinel_schedule           = "rate(5 minutes)"
devops_agent_space_id       = ""
devops_agent_association_id = ""
expect_elevated_actions     = true
alert_email                 = ""

# Agent identity (mcp/CONTRACT.md, Agent identity). One OAuth client per agent; an
# entry without client_id gets a Cognito app client. The interceptor identifies the
# caller; false is the legacy mode without per-agent attribution or limits. Per-agent
# kill switches are /<name_prefix>/agents/<agent>/enabled (agent_kill_switch_parameters).
caller_interceptor_enabled = true
agents = {
  devops_agent = {}
  smoke_test   = {} # { hourly_apply_budget = 30 } for the end-to-end tests
}
agent_hourly_apply_budget = 10

# Server-side approval (mcp/CONTRACT.md, Server-side approval). client keeps the
# DevOps Agent chat approval only; server and both require an approval through the
# approval URL from one of approver_principals (IAM user or role ARNs).
approval_mode                     = "server"
approver_principals               = ["arn:aws:iam::111122223333:role/my-approver-role"]
approval_require_mfa              = true # false only for test identities without MFA
approval_wait_ttl_seconds         = 900
apply_after_approval_ttl_seconds  = 120
approval_request_cooldown_seconds = 60
approval_request_limit            = 10
approval_email                    = ""

# Network (docs/deploy.md, Network). Empty lambda_subnet_ids runs the tool Lambdas
# outside any VPC, which needs the cluster's public endpoint open to 0.0.0.0/0. For a
# cluster with a private endpoint, list subnets in the cluster's VPC that reach it;
# the subnets must reach DynamoDB, EKS, SSM and SNS through a NAT gateway or VPC endpoints.
lambda_subnet_ids         = [] # e.g. ["subnet-0123456789abcdef0", "subnet-0fedcba9876543210"]
lambda_security_group_ids = [] # empty: create one that allows outbound HTTPS only
# Adds inbound 443 from the Lambdas' security groups to the cluster security group.
# Needs private endpoint access on the cluster, like create_vpc_endpoints.
allow_lambda_to_cluster_endpoint = false
# Interface endpoints for eks, ssm and sns plus a DynamoDB gateway endpoint, for subnets
# without a NAT gateway, on the subnets' route tables. Leave false if the VPC already has
# endpoints for these services.
create_vpc_endpoints = false

# build/ is gitignored. On a fresh checkout with existing state, rebuild before planning:
#   terraform apply -replace='terraform_data.build["k8s_read"]' -replace='terraform_data.build["k8s_write"]' -replace='terraform_data.build["sentinel"]' -replace='terraform_data.build["approver"]' -replace='terraform_data.build["interceptor"]'
